# ── .env.example (7주차) ─────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지"만 알려주는 견본입니다.  커밋합니다.
#
# 사용법:
#   1) 이 파일을 복사해 .env 로 이름을 바꾼다
#   2) .env 의 = 뒤에 실제 키 값을 넣는다
#   3) .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음)
#
#   git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
# ─────────────────────────────────────────────────────────────

# ── 6주차와 동일 — 새로 추가되는 키는 없습니다 ★ ─────────────
LANGSMITH_TRACING=true

# smith.langchain.com → Settings → API Keys
# 형태: lsv2_pt_...    ⚠️ 따옴표 없이, 앞뒤 공백 없이 붙여넣습니다.
LANGSMITH_API_KEY=

# ★ 프로젝트 이름을 7주차용으로 바꿉니다.
#   (평가 실험은 experiment_prefix 로 따로 묶이지만, 일반 실행은 여기로 들어갑니다)
LANGSMITH_PROJECT=week07-eval

# LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ── 🔶 LLM 판정자용 (2교시 2-2) — 배정 4순위 ─────────────────
# 판정자에만, 소규모 데이터셋에만 씁니다. 비워 두면 로컬 판정자만 돌아갑니다.
OPENAI_API_KEY=


# ── 🔶 실습실 대비책 ─────────────────────────────────────────
# 구조화 출력에서 토큰을 보려고 include_raw=True 를 씁니다(metrics.py).
# 실습실 버전에서 말썽이면 아래 주석을 풀어 끄십시오.
# 토큰은 "측정 불가" 로 처리되고 정확도·지연은 그대로 측정됩니다.
# WEEK07_INCLUDE_RAW=false


# ── ⚠️ 한도 관리 3원칙 중 ③ ─────────────────────────────────
# 코드가 안 돌아 디버깅만 반복할 때는 추적을 꺼서 traces 를 아끼십시오.
#   LANGSMITH_TRACING=false
#
# ⚠️⚠️ 개인 신용카드를 절대 등록하지 마십시오.
#      무료 Developer 플랜은 카드 없이 가입되고, 한도(월 5,000 traces)를 넘으면
#      429로 거부될 뿐 과금되지 않습니다(하드 캡).
#      카드를 등록하면 그 안전장치가 풀립니다.
