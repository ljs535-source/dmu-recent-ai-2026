# ── .env.example (14주차) ────────────────────────────────────
#   git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
# ─────────────────────────────────────────────────────────────

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week14-multiagent

# 🔶 도구 호출 지원 모델 — 9·13주차와 같습니다
TOOL_MODEL=gemma3:4b
MODEL=gemma3:4b


# ── ⚠️ 멀티 에이전트 안전장치 ★★ ────────────────────────────
# 비용이 **곱으로** 늘어납니다.
#   Supervisor 판단 1회 + 워커 실행 → 다시 Supervisor …
#   에이전트 3개 × 순환 = 단일 에이전트의 몇 배 호출 ⚠️
#
# 로컬 모델 기준: 에이전트 2~3개, recursion_limit 은 낮게.
# 30명 동시 실행 시 GPU 부하를 고려해 **순차 실행을 유도**하십시오. ★
WEEK14_MAX_STEPS=6
WEEK14_RECURSION_LIMIT=15


# ── 🔶 실습 3 (langgraph dev) ────────────────────────────────
# 포트가 충돌하면 바꾸십시오.
# LANGGRAPH_PORT=2024


# ── 🔶 3교시 운영 관점 — 피드백 수집 예시에 씁니다 ─────────────
# 실제로 피드백을 붙이려면 LANGSMITH_API_KEY 가 필요합니다.
