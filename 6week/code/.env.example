# ── .env.example (6주차) ─────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지"만 알려주는 견본입니다.  커밋합니다.
#
# 사용법:
#   1) 이 파일을 복사해 .env 로 이름을 바꾼다
#   2) .env 의 = 뒤에 실제 키 값을 넣는다
#   3) .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음)
#
# ⚠️ 오늘 키가 하나 더 늘었습니다. 실습 시작 전 반드시 확인하세요:
#       git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
#    출력이 없으면 .env 가 커밋 대상입니다. .gitignore 부터 고치세요.
# ─────────────────────────────────────────────────────────────

# ── 4주차에 넣은 상용 API 키 ─────────────────────────────────
OPENAI_API_KEY=


# ── 오늘 추가 ★ ──────────────────────────────────────────────
# 추적 켜기/끄기 스위치.  false 로 두면 아무것도 전송되지 않습니다.
LANGSMITH_TRACING=true

# smith.langchain.com → Settings → API Keys → Create API Key
# 형태: lsv2_pt_...    ⚠️ 따옴표 없이, 앞뒤 공백 없이 붙여넣습니다.
LANGSMITH_API_KEY=

# 기록을 담을 프로젝트 이름.  안 넣으면 default 프로젝트로 들어갑니다.
# (추가) 여기 값은 '기본값' 입니다. 실행할 때 바꾸려면 .env 를 고치지 말고:
#        LANGSMITH_PROJECT=week07-eval python trace_on.py     (Git Bash)
LANGSMITH_PROJECT=week06-tracing

# 전송 주소.  기본값을 쓰므로 보통 건드리지 않습니다.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ── 변수 이름에 관한 참고 ────────────────────────────────────
# 예전 이름은 LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT
# 였습니다. 지금도 대개 함께 인식됩니다. 인터넷 예제에서 이 이름을 보면
# 같은 것입니다. 위의 LANGSMITH_ 이름을 쓰세요. ★
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=week06-tracing


# ── (추가) 4교시 Slack Socket Mode 봇 ─────────────────────────
# 5주차 4교시에 받은 봇 토큰을 그대로 씁니다. (xoxb- · 보내는 선)
SLACK_BOT_TOKEN=

# ★ 오늘 추가 — 앱 수준 토큰 (xapp- · 받는 선)
# api.slack.com/apps → 내 앱 → Settings → Socket Mode → Enable
#   → 토큰 이름 입력 → Generate → xapp-... 복사
# (나중에 다시 볼 때: Basic Information → App-Level Tokens)
# ⚠️ xoxb 와 자리를 바꿔 넣으면 not_allowed_token_type 이 납니다.
SLACK_APP_TOKEN=

# (선택) openai 를 쓸 수 있는 사람의 멤버 ID — 쉼표로 여러 명
# 비워 두면 워크스페이스 누구나 내 OpenAI 키로 질문할 수 있습니다 (비용은 내 몫 ⚠️)
# 내 멤버 ID: 슬랙에서 내 프로필 → ⋮ → 멤버 ID 복사 (U 로 시작)
SLACK_ALLOWED_USERS=


# ⚠️⚠️ 개인 신용카드를 절대 등록하지 마십시오.
#      무료 Developer 플랜은 카드 없이 가입되고, 한도를 넘으면
#      429로 거부될 뿐 과금되지 않습니다(하드 캡).
#      카드를 등록하면 그 안전장치가 풀립니다.
