# ── .env.example ─────────────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지"만 알려주는 견본입니다.  커밋합니다.
#
# 사용법:
#   1) 이 파일을 복사해 .env 로 이름을 바꾼다
#   2) .env 의 = 뒤에 실제 키 값을 넣는다
#   3) .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음)
#
# ⚠️ 실습 시작 전 확인: git status 에 .env 가 보이면 안 됩니다.
#    보인다면 .gitignore 부터 고치세요. (3주차 1교시 내용)
# ─────────────────────────────────────────────────────────────

# 오늘 수업 중 배포되는 학과 공용 키를 넣습니다.
# 실습 종료 후 회수·회전되므로, 다음 주에는 동작하지 않을 수 있습니다.
OPENAI_API_KEY=

# ⚠️ 본 차시에서는 사용하지 않습니다.
#    Claude Code 구독 계정으로는 API 호출이 불가합니다.
# ANTHROPIC_API_KEY=
