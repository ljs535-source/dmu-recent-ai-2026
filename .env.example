# ── 1~3교시 ──────────────────────────────────────────────────
# 로컬 모델(Ollama)로 진행하므로 키가 필요 없습니다.
# 🔶 with_structured_output() 이 로컬 모델에서 끝내 안 될 때만 OpenAI 로 대체합니다.
OPENAI_API_KEY=

# ── 4교시 Slack ★ 오늘 추가 ──────────────────────────────────
# api.slack.com/apps → Create New App → **Blank app**
#   → OAuth & Permissions → Bot Token Scopes 에 chat:write 추가
#   → 페이지 맨 위 Install to <워크스페이스> → Allow
#   → **Bot User OAuth Token** 을 복사해 아래에 붙여넣습니다.
#
# 형태: xoxb-...     ⚠️ 따옴표 없이, 앞뒤 공백 없이 붙여넣습니다.
#                       (따옴표·공백이 invalid_auth 의 가장 흔한 원인입니다)
# ⚠️ xoxp- 로 시작하는 User 토큰이 아닙니다. xoxb- 여야 합니다.
SLACK_BOT_TOKEN=

# 메시지를 보낼 채널. '#' 을 포함해 적습니다.
# #수업-출력물 은 교수자가 미리 만들어 둔 공용 채널입니다. 직접 만들 필요 없습니다.
# ⚠️ 채널에 참여한 뒤 /invite @본인앱이름 으로 봇을 초대해 두어야 합니다.
#    (안 하면 not_in_channel 에러)
SLACK_CHANNEL=#수업-출력물


LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="week07-tracing"

# ★ 오늘 추가 — 앱 수준 토큰 (xapp- · 받는 선)
# api.slack.com/apps → 내 앱 → Settings → Socket Mode 가 켜져 있는지 확인
#   → Basic Information → App-Level Tokens → Generate Token and Scopes
#   → 이름 socket · Add Scope → connections:write → Generate → xapp-... 복사
#  xoxb 와 자리를 바꿔 넣으면 not_allowed_token_type 이 납니다.
SLACK_APP_TOKEN=