# ── .env.example (12주차) ─────────────────────────────────────
# 아래 줄을 저장소 맨 위의 .env (루트, 하나뿐) 에 옮겨 적습니다.
# LANGSMITH_* · OPENAI_API_KEY · SLACK_*_TOKEN · EMBED_MODEL 은 이미 루트 .env 에 있습니다.
# 실습 4 에서 실행 경로를 보려면 LangSmith 추적이 켜져 있어야 합니다 (LANGSMITH_TRACING=true).
# LANGSMITH_PROJECT=week12-graph

# ── 순환 안전장치 ★ (reflection.py) ───────────────────────────
#   반복 1회 = 생성 1회 (+ --judge llm 이면 평가 1회)
WEEK12_MAX_ATTEMPTS=3      # ① 논리적 종료 — 우리가 설계
WEEK12_RECURSION_LIMIT=10  # ② 안전망 — 프레임워크의 강제 차단 (아무것도 안 적으면 1만 단계)

# ★ 10주차 인덱스 위치 (rag_router_graph.py) — 기본값이 10week_new/code/index_recursive 라서 보통은 적지 않아도 됩니다.
#   슬랙 봇의 학칙.pdf 인덱스를 쓰려면: WEEK12_INDEX=../../10week_new/code/slack_bot_mode/index_pdf
# WEEK12_INDEX=../../10week_new/code/index_recursive
