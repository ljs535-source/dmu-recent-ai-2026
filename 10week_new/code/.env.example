# ── .env.example (10주차) ─────────────────────────────────────
# 아래 줄을 저장소 맨 위의 .env (루트, 하나뿐) 에 옮겨 적습니다.
# LANGSMITH_* · OPENAI_API_KEY · SLACK_*_TOKEN 은 이미 루트 .env 에 있습니다.

# ★ 이번 주 새로 — 11 · 13주차도 이 값을 읽습니다
EMBED_MODEL=qwen3-embedding:0.6b
#   바꾸면 인덱스를 다시 만들어야 합니다 (python embed.py)
#   8GB GPU 후보: qwen3-embedding:4b(≒2.5GB) · bge-m3(≒1.2GB)
#   ❌ qwen3-embedding:8b — gemma3:4b + KV 캐시와 합치면 8GB 초과

# (선택) 실습 2 — 질문을 바꿔 실험해 보세요
# WEEK10_QUESTION=몇 주를 결석하면 제적되나요?

# (선택) 슬랙 봇 slack_bot_mode — openai 를 나만 쓰게 (내 멤버 ID)
# SLACK_ALLOWED_USERS=U0XXXXXXX
