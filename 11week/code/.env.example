# ── .env.example (11주차) ────────────────────────────────────
#   git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
# ─────────────────────────────────────────────────────────────

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week11-retrieval

MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text

# ── ★★ 10주차에 저장한 인덱스를 그대로 이어 씁니다 ──────────
# 상대 경로는 이 폴더(week11/code) 기준입니다.
# 없으면 코드가 10주차 문서로 그 자리에서 다시 만들어 줍니다(재적재 — 느립니다). 🔶
WEEK11_INDEX=../../10week/code/index_recursive

# 재적재가 필요할 때 쓸 원본 문서
WEEK11_DOC=../../10week/code/data/학칙.md
