# ── .env.example (12주차) ────────────────────────────────────
#   git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
# ─────────────────────────────────────────────────────────────

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week12-graph

MODEL=gemma3:4b


# ── ⚠️ 순환 안전장치 ★★ ─────────────────────────────────────
# 종료 조건 없는 루프가 30명 PC 에서 동시에 돌면 실습실 전체가 느려집니다.
#
#   반복 1회 = LLM 호출 2회 (생성 + 평가)
#   반복 3회 = 6회 호출  × 30명 = 180회   ⚠️ 실습실 GPU 부하
WEEK12_MAX_ATTEMPTS=3      # ① 논리적 종료 — 우리가 설계 ★
WEEK12_RECURSION_LIMIT=10  # ② 안전망 — 프레임워크의 강제 차단
