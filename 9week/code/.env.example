# ── .env.example (9주차) ─────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지"만 알려주는 견본입니다.  커밋합니다.
#
# 사용법:
#   1) 이 파일을 복사해 .env 로 이름을 바꾼다
#   2) .env 의 = 뒤에 실제 값을 넣는다
#   3) .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음)
#
#   git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
# ─────────────────────────────────────────────────────────────

# ── 추적 — 7주차와 동일, 프로젝트 이름만 바꿉니다 ─────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week09-tools


# ── 🔶 도구 호출을 지원하는 로컬 모델 ★★ ─────────────────────
# ⚠️ 모든 모델이 도구 호출을 지원하지는 않습니다.
#    지원하지 않는 모델에 bind_tools() 를 하면 tool_calls 가 늘 비어 있고,
#    실습 1 자체가 성립하지 않습니다.
#
#    학기 시작 전 실습실 PC 에서 반드시 1회 확인하십시오: ★
#        python tool_support_check.py
#    통과한 모델 이름을 아래에 적으십시오.
TOOL_MODEL=gemma3:4b

# 도구를 붙이지 않는 일반 생성용 (선수 주차와 동일)
MODEL=gemma3:4b


# ── 🔶 상용 API — 본 차시는 배정 1순위입니다 ★ ───────────────
# 실습 2 의 "로컬 vs 상용 도구 선택 정확도 비교" 에 씁니다.
# 비워 두면 실습 2 는 로컬 모델만으로 돌아갑니다(비교 없이 단독 측정).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ── 🔶 실습 2 검색 도구 대비책 ★★ ───────────────────────────
# 강의실 전체가 같은 공인 IP 를 씁니다. 30명이 동시에 검색하면
# DuckDuckGo 가 레이트리밋으로 차단하고 18분짜리 실습이 통째로 멈춥니다. ⚠️
#
#   duckduckgo  기본값. 조별 순차 실행으로 운영할 것 ★
#   fake        차단됐을 때 — 고정 결과를 돌려주는 가짜 검색 도구
#               (도구 호출 흐름 학습이 목적이지 검색 품질이 목적이 아닙니다)
WEEK09_SEARCH=duckduckgo

# 검색 호출 사이에 둘 간격(초). 레이트리밋 완화용 ★
WEEK09_SEARCH_DELAY=3
