# ── .env.example (9주차) ─────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지"만 알려주는 견본입니다.  커밋합니다.
#
# 사용법:
#   저장소 맨 위 폴더의 .env (하나뿐인 그 파일) 에 아래 줄들을 옮겨 적고
#   = 뒤에 실제 값을 넣습니다.  week09/ 안에 .env 를 새로 만들지 마세요.
#
# ⚠️ 오늘 토큰이 하나 더 늘었습니다. 실습 시작 전 반드시 확인하세요:
#       git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
#    출력이 없으면 .env 가 커밋 대상입니다. .gitignore 부터 고치세요.
# ─────────────────────────────────────────────────────────────

# ── 4주차에 넣은 상용 API 키 — 봇의 openai 백엔드가 씁니다 ─────
OPENAI_API_KEY=


# ── 6주차에 넣은 LangSmith — 그대로 둡니다 ────────────────────
# true 면 슬랙 질문 1건이 trace 1건으로 남습니다 (태그 week09-slack).
# 남이 내 봇에 보낸 질문도 기록됩니다 — 끄려면 false.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# 프로젝트 이름은 6주차 값 그대로 둡니다 — 오늘 질문은 태그 week09-slack 으로 거릅니다.
# (따로 담고 싶으면 .env 를 고치지 말고 실행할 때: LANGSMITH_PROJECT=week09-slack python slack_llm_bot.py   ← Git Bash)
LANGSMITH_PROJECT=week06-tracing


# ── 슬랙 (3교시) ──────────────────────────────────────────────
# 5주차 4교시에 받은 봇 토큰을 그대로 씁니다. (xoxb- · 보내는 선)
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=

# ★ 오늘 추가 — 앱 수준 토큰 (xapp- · 받는 선)
# api.slack.com/apps → 내 앱 → Settings → Socket Mode 가 켜져 있는지 확인
#   → Basic Information → App-Level Tokens → Generate Token and Scopes
#   → 이름 socket · Add Scope → connections:write → Generate → xapp-... 복사
# ⚠️ xoxb 와 자리를 바꿔 넣으면 not_allowed_token_type 이 납니다.
SLACK_APP_TOKEN=

# (선택) openai 를 쓸 수 있는 사람의 멤버 ID — 쉼표로 여러 명
# 비워 두면 워크스페이스 누구나 내 OpenAI 키로 질문할 수 있습니다 (비용은 내 몫 ⚠️)
# 내 멤버 ID: 슬랙에서 내 프로필 → ⋮ → 멤버 ID 복사 (U 로 시작)
#SLACK_ALLOWED_USERS=

# (5주차 send_slack_message.py 가 쓰던 채널 — 오늘 봇은 쓰지 않습니다. 있으면 그대로 두세요)
# SLACK_CHANNEL=#수업-출력물
