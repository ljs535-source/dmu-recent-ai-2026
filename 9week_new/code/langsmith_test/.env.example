# ── .env.example (9주차 과제 · langsmith_test/) ──────────────────────
# trace_on_openai.py · self_consistency_openai.py · prompt_hub_openai.py 를 돌리는 데 필요한 키 견본입니다.  커밋합니다.
# (prompt_hub_openai.py 는 OPENAI_API_KEY · LANGSMITH_API_KEY 만 있으면 됩니다 — Prompt Hub 는 추적 스위치와 무관)
#
# 사용법:
#   저장소 맨 위 폴더의 .env (하나뿐인 그 파일) 에 아래 줄들이 있는지 확인하고,
#   없는 줄만 옮겨 적은 뒤 = 뒤에 실제 값을 넣습니다.
#   4주차 · 6주차에 넣었다면 이미 다 있습니다 — 값만 확인하세요.
#   ⚠️ week09/langsmith_test/ 안에 .env 를 새로 만들지 마세요. 코드는 위로 올라가며 .env 를 찾습니다.
#
# ⚠️ 실행 전 반드시 확인:
#       git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
#    출력이 없으면 .env 가 커밋 대상입니다. .gitignore 부터 고치세요.
# ─────────────────────────────────────────────────────────────

# ── ① OpenAI — 두 파일 모두 gpt-4o-mini 로만 답합니다 (4주차) ──
# platform.openai.com → API keys → Create new secret key
# 형태: sk-...    ⚠️ 따옴표 없이, 앞뒤 공백 없이 붙여넣습니다.
OPENAI_API_KEY=


# ── ② LangSmith — 이 과제의 목적 (6주차) ★ ────────────────────
# 반드시 true. false 거나 키가 비어 있으면 두 파일은 실행 전에 멈춥니다.
LANGSMITH_TRACING=true

# smith.langchain.com → Settings → API Keys → Create API Key
# 형태: lsv2_pt_...    ⚠️ 따옴표 없이, 앞뒤 공백 없이 붙여넣습니다.
LANGSMITH_API_KEY=

# 기록이 쌓일 프로젝트 이름. 6주차 값 그대로 둡니다 — 과제 기록은 태그 week09-openai 로 거릅니다.
# (따로 담고 싶으면 .env 를 고치지 말고 실행할 때:
#        LANGSMITH_PROJECT=week09-homework python trace_on_openai.py     ← Git Bash)
LANGSMITH_PROJECT=week06-tracing

# 전송 주소.  기본값을 쓰므로 보통 건드리지 않습니다.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ── 필요 없는 것 ─────────────────────────────────────────────
# Ollama · SLACK_* · TOOL_MODEL 은 이 두 파일에 필요 없습니다.
# 이미 .env 에 있다면 그대로 두세요 — 지우지 않아도 됩니다.


# ⚠️⚠️ LangSmith 에 개인 신용카드를 절대 등록하지 마십시오.
#      무료 Developer 플랜은 한도(월 5,000 traces)를 넘으면 거부될 뿐 과금되지 않습니다.
#      카드를 등록하면 그 안전장치가 풀립니다.
