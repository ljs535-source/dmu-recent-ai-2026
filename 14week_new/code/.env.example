# ── .env.example (14주차) ─────────────────────────────────────
# 아래 줄을 저장소 맨 위의 .env (루트, 하나뿐) 에 옮겨 적습니다.
# LANGSMITH_* 는 이미 루트 .env 에 있습니다. 적지 않은 줄은 코드 기본값을 씁니다.

# 도구를 쓰는 담당자(researcher · calculator · hitl) 의 모델
#   ⚠️ gemma3:4b 는 Ollama 에서 도구 호출을 지원하지 않습니다 (9주차 실측).
# TOOL_MODEL=llama3.2:3b
# supervisor · writer 의 모델 (도구를 쓰지 않음)
# MODEL=gemma3:4b

# 멀티 에이전트 안전장치 — supervisor 판단 상한 / 그래프 전체 상한
# WEEK14_MAX_STEPS=6
# WEEK14_RECURSION_LIMIT=15

# 10주차 인덱스 위치 — 이 폴더(14week_new/code) 기준 상대 경로. 보통은 적지 않아도 됩니다.
# WEEK14_INDEX=../../10week_new/code/index_recursive
