# ── .env.example (13주차) ─────────────────────────────────────
# 아래 줄을 저장소 맨 위의 .env (루트, 하나뿐) 에 옮겨 적습니다.
# LANGSMITH_* · OPENAI_API_KEY · SLACK_*_TOKEN 은 이미 루트 .env 에 있습니다.
# 적지 않으면 코드 기본값을 씁니다 — 보통은 아무것도 안 적어도 됩니다.

# ★ 도구 호출 모델 — 기본값 llama3.2:3b (gemma3:4b 는 Ollama 도구 호출 미지원)
#   gpt- 로 시작하는 이름을 적으면 OpenAI 로 돕니다 (4주차에 넣은 공용 키 OPENAI_API_KEY — 수업 실습용).
# TOOL_MODEL=gpt-4o-mini
# TOOL_MODEL=llama3.2:3b

# 실습 4 (Agentic RAG) 판단·답변 모델 — 도구 호출을 쓰지 않아 gemma3:4b 로 됩니다
# MODEL=gemma3:4b

# ⚠️ 10주차 인덱스를 만든 임베딩 모델과 같아야 합니다
# EMBED_MODEL=qwen3-embedding:0.6b

# 10주차 인덱스 위치 — 기본값이 10week_new/code/index_recursive 라서 보통은 적지 않습니다.
#   다른 곳에 저장했다면 이 폴더(13week_new/code) 기준 상대 경로로 적습니다.
# WEEK13_INDEX=../../10week_new/code/index_recursive

# 순환 안전장치 — 노드 실행 횟수 상한 / Agentic RAG 재검색 상한
# WEEK13_RECURSION_LIMIT=10
# WEEK13_MAX_RETRY=2
