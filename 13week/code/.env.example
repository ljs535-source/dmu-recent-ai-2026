# ── .env.example (13주차) ────────────────────────────────────
#   git check-ignore -v .env      # 출력이 나오면 무시되고 있는 것 = 안전 ★
# ─────────────────────────────────────────────────────────────

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week13-agent


# ── 🔶 도구 호출 지원 모델 — 9주차와 같습니다 ★ ──────────────
# ⚠️ 순환 판단이 반복되므로 소형 모델은 무한 루프·조기 종료가 잦습니다.
#    본 차시는 **상용 API 배정 2순위**입니다.
#    9주차의 tool_support_check.py 로 확정한 모델을 적으십시오.
TOOL_MODEL=gemma3:4b

# 판단·평가·생성용 (Agentic RAG)
MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text


# ── ⚠️ 순환 안전장치 ★★ ─────────────────────────────────────
# 무한 루프가 나면 30명 PC 에서 동시에 돌아 실습실 전체가 느려집니다.
WEEK13_RECURSION_LIMIT=10


# ── ★★ 11주차(=10주차 산출물) RAG 인덱스 — 실습 4가 씁니다 ──
# 상대 경로는 이 폴더(week13/code) 기준입니다.
WEEK13_INDEX=../../10week/code/index_recursive
WEEK13_DOC=../../10week/code/data/학칙.md

# 검색 재시도 상한 (Agentic RAG 의 종료 조건 ★)
WEEK13_MAX_RETRY=2


# ── 상용 API (선택) — 순환 판단이 흔들릴 때 ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
